# NEXA server configuration. Copy to .env and edit. Every setting is an environment variable.
# Empty value = feature not configured (the server still starts; /readyz reports "not_configured").

# --- Server -----------------------------------------------------------------
NEXA_HOST=0.0.0.0
NEXA_PORT=8000
NEXA_LOG_LEVEL=INFO
# Comma-separated allowed browser origins. Empty = CORS disabled (the Windows client does not need it).
NEXA_CORS_ORIGINS=
# Optional: serve HTTPS directly. Leave empty when a reverse proxy terminates TLS.
# The Windows client requires an HTTPS URL with a certificate trusted by Windows.
NEXA_TLS_CERT_FILE=
NEXA_TLS_KEY_FILE=

# --- Admin panel (web, served at /admin/) -----------------------------------
# Set false to remove the panel entirely (then every AD user in the required group can sign in).
NEXA_ADMIN_ENABLED=true
# SQLite file: allow-list of users, settings saved from the panel, audit log. Keep it on a volume.
NEXA_ADMIN_DB_PATH=/data/nexa.db
# Used ONCE to create the admin password when none exists (min 12 chars). The panel then asks you to
# change it; remove this line afterwards. Or run: docker compose exec nexa-server nexa-admin-password
NEXA_ADMIN_INITIAL_PASSWORD=
NEXA_ADMIN_SESSION_TTL_SECONDS=3600
# Keep true behind HTTPS. Set false ONLY for plain-http local development, otherwise login won't stick.
NEXA_ADMIN_COOKIE_SECURE=true
# Optional separate key (>= 32 chars) for encrypting secrets saved in the panel. Empty = derived from
# NEXA_TOKEN_SECRET. If this key changes, saved secrets become unreadable and must be re-entered.
NEXA_SETTINGS_KEY=

# --- Sessions / tokens ------------------------------------------------------
# REQUIRED. At least 32 random characters, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
NEXA_TOKEN_SECRET=
# Lifetime of the bearer token returned by POST /api/v1/session.
NEXA_TOKEN_TTL_SECONDS=3600
# Failed logins allowed per (client IP + username) inside the window; per-IP limit is 4x this value.
NEXA_RATE_LIMIT_MAX_FAILURES=5
NEXA_RATE_LIMIT_WINDOW_SECONDS=300

# --- Access control / memory (next phase) -----------------------------------
# deny       = every data connector call is refused (default, safe).
# permissive = allow everything. Development only; logs a warning at startup.
NEXA_POLICY_MODE=deny

# --- LLM through krouter (OpenAI-compatible router) -------------------------
# The server only ever uses the ALIAS names below. Re-point aliases inside the router, not here.
NEXA_LLM_BASE_URL=http://krouter.internal:20128/v1
NEXA_LLM_API_KEY=
NEXA_LLM_TIMEOUT_SECONDS=60
NEXA_MODEL_CHAT=nexa-chat
NEXA_MODEL_SQL=nexa-sql
NEXA_MODEL_FAST=nexa-fast
# Optional embedding alias (not used by the graph yet).
NEXA_MODEL_EMBEDDING=

# --- Active Directory (LDAP) ------------------------------------------------
NEXA_LDAP_URL=ldaps://dc01.example.local:636
NEXA_LDAP_BASE_DN=DC=example,DC=local
# Read-only service account used to look users up (never the user's own bind).
NEXA_LDAP_BIND_DN=CN=svc-nexa,OU=Service,DC=example,DC=local
NEXA_LDAP_BIND_PASSWORD=
# {username} is escaped and substituted. Default matches sAMAccountName or UPN.
NEXA_LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person)(|(sAMAccountName={username})(userPrincipalName={username})))
# Members (nested groups included) may use NEXA. Empty = any authenticated AD user (not recommended).
NEXA_LDAP_REQUIRED_GROUP_DN=CN=NEXA-Users,OU=Groups,DC=example,DC=local
# NetBIOS domain used in the canonical account id, e.g. EXAMPLE -> EXAMPLE\jsmith. REQUIRED with LDAP.
NEXA_LDAP_NETBIOS_DOMAIN=EXAMPLE
NEXA_LDAP_TLS_VERIFY=true
# PEM CA bundle for the domain controllers (empty = system trust store).
NEXA_LDAP_CA_FILE=
NEXA_LDAP_TIMEOUT_SECONDS=10

# --- OpenMetadata -----------------------------------------------------------
NEXA_OPENMETADATA_URL=https://openmetadata.internal:8585
# JWT of a bot user with read access.
NEXA_OPENMETADATA_TOKEN=
NEXA_OPENMETADATA_TIMEOUT_SECONDS=15
NEXA_OPENMETADATA_VERIFY_TLS=true

# --- Cube -------------------------------------------------------------------
# REST API root, including /cubejs-api/v1.
NEXA_CUBE_API_URL=http://cube.internal:4000/cubejs-api/v1
# Either a ready token, or the API secret (the server then signs a short-lived JWT per request).
NEXA_CUBE_API_TOKEN=
NEXA_CUBE_API_SECRET=
NEXA_CUBE_TIMEOUT_SECONDS=60
NEXA_CUBE_VERIFY_TLS=true
NEXA_CUBE_MAX_ROWS=10000

# --- ClickHouse (HTTP interface) --------------------------------------------
NEXA_CLICKHOUSE_HOST=clickhouse.internal
NEXA_CLICKHOUSE_PORT=8123
NEXA_CLICKHOUSE_USER=nexa_ro
NEXA_CLICKHOUSE_PASSWORD=
NEXA_CLICKHOUSE_DATABASE=default
NEXA_CLICKHOUSE_SECURE=false
NEXA_CLICKHOUSE_VERIFY=true
# Adds readonly=2 to every query. Also use a read-only ClickHouse user.
NEXA_CLICKHOUSE_READONLY=true
NEXA_CLICKHOUSE_MAX_ROWS=10000
NEXA_CLICKHOUSE_MAX_EXECUTION_TIME_SECONDS=30
